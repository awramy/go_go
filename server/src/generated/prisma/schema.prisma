// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tg_account {
  id           Int            @id @default(autoincrement())
  phone        String
  username     String
  firstname    String
  lastname     String?
  proxy        Proxy?         @relation(fields: [proxyId], references: [id])
  proxyId      Int?           @unique
  comments     Comment[]
  session      Session?       @relation(fields: [sessionId], references: [id])
  sessionId    Int?           @unique
  ChatUserList ChatUserList[]
  warmingData  WarmingData?
}

model Session {
  id            Int         @id @default(autoincrement())
  sessionString String
  apiId         String
  apiHash       String
  Tg_account    Tg_account?
}

model Comment {
  id        Int         @id @default(autoincrement())
  account   Tg_account? @relation(fields: [accountId], references: [id])
  accountId Int?
  message   String
}

model Proxy {
  id         Int         @id @default(autoincrement())
  type       ProxyType
  host       String
  port       Int
  isIPv6     Boolean     @default(false)
  login      String?
  password   String?
  Tg_account Tg_account?
}

enum ProxyType {
  socks5
  http
  https
  socks
}

////parsing

model ChatUserList {
  id           Int           @id @default(autoincrement())
  name         String
  tg_account   Tg_account    @relation(fields: [tg_accountId], references: [id])
  tg_accountId Int
  users        UserData[]
  warmingData  WarmingData[]

  @@index([tg_accountId])
}

model UserData {
  id         Int          @id @default(autoincrement())
  userList   ChatUserList @relation(fields: [userListId], references: [id])
  userListId Int
  username   String?
  phone      String?

  @@index([userListId])
}

////warming

model WarmingData {
  id Int @id @default(autoincrement())

  //привязываем аккаунт к Warming (один аккаунт - один прогрев)
  tg_account   Tg_account @relation(fields: [tg_accountId], references: [id])
  tg_accountId Int        @unique

  //привязывем базу пользователей к Warming (одна база - много warming)
  userList   ChatUserList @relation(fields: [userListId], references: [id])
  userListId Int

  //привязваем фейковую роль аккаунта при прогреве (одна роль - много warming)
  fakeUserRole   FakeUserRole @relation(fields: [fakeUserRoleId], references: [id])
  fakeUserRoleId Int

  timeLastStep     DateTime @default(now())
  timeStop         DateTime
  stepCounter      Int      @default(0)
  messagesCounter  Int      @default(0)
  answersCounter   Int      @default(0)
  reactionsCounter Int      @default(0)
  commentsCounter  Int      @default(0)

  messagesPerHour  Int
  answersPerHour   Int
  reactionsPerHour Int
  commentsPerHour  Int

  //стартовая задержка в секундах (между целевыми действиями)
  startDelay Int
}

model FakeUserRole {
  id          Int           @id @default(autoincrement())
  role        String
  description String
  warmingData WarmingData[]
}
